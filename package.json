{
  "name": "xmas-lights",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @xmas/server",
    "dev:web": "npm run dev -w @xmas/web",
    "build:web": "npm run build -w @xmas/web",
    "start": "npm run start -w @xmas/server",
    "test": "vitest run",
    "typecheck": "tsc -b && npm run typecheck -w @xmas/web"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
